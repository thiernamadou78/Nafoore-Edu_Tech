# ────────────────────────────────────────────────────
# Supabase — projet : https://supabase.com/dashboard
# ────────────────────────────────────────────────────
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ────────────────────────────────────────────────────
# Base de données Postgres (Prisma)
# Récupérer depuis : Settings > Database > Connection string
# ────────────────────────────────────────────────────

# Mode pooling (PgBouncer) — utilisé par le backend NestJS au runtime
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[host]:6543/postgres?pgbouncer=true

# Connexion directe — utilisée par Prisma pour les migrations
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@[host]:5432/postgres

# ────────────────────────────────────────────────────
# Backend NestJS
# ────────────────────────────────────────────────────
PORT=3000
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ────────────────────────────────────────────────────
# Onboarding lead → compte portail (email transactionnel)
# Sans RESEND_API_KEY, les emails sont loggés en console (mode dev)
# ────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@nafoore.fr

# Portails externes (liens utilisés dans l'email de bienvenue — placeholders
# tant que ces portails ne sont pas développés)
FAMILLE_URL=http://localhost:5175
ECOLE_PORTAL_URL=http://localhost:5176
ENTREPRISE_PORTAL_URL=http://localhost:5177
MAIRIE_PORTAL_URL=http://localhost:5178

# ────────────────────────────────────────────────────
# Frontend React (préfixe VITE_ obligatoire)
# ────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000

# ────────────────────────────────────────────────────
# Admin React (apps/admin, préfixe VITE_ obligatoire)
# Même projet Supabase, clé anon uniquement (jamais la service role côté client)
# ────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://[project-ref].supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
