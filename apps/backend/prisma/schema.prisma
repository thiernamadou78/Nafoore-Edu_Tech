generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Mode pooling (PgBouncer) — utilisé au runtime
  url       = env("DATABASE_URL")
  // Connexion directe — utilisée par prisma migrate
  directUrl = env("DIRECT_URL")
}

model Lead {
  id               String        @id @default(cuid())
  createdAt        DateTime      @default(now()) @map("created_at")
  profile          String        // famille | mairie | entreprise | centre_formation_ecole_pro
  gender           String?       // homme | femme
  name             String
  email            String
  phone            String?
  message          String
  // aide_devoirs | soutien_scolaire | preparation_brevet | preparation_bac |
  // coaching_methodologique | stages_vacances | accompagnement_bilingue
  // Plusieurs possibles : une famille peut avoir plusieurs enfants avec des
  // besoins differents.
  services         String[]      @default([])
  address          String?
  // Ameliore la precision du geocodage (voir GeocodingService.geocode).
  postalCode       String?       @map("postal_code")
  // Ville / commune : seule la ville et le code postal sont communiques aux
  // enseignants lors d'une proposition, jamais l'adresse complete.
  city             String?
  // Geocodees automatiquement (best-effort) a partir de `address` — servent
  // au pin "famille" sur la carte du tableau de bord admin.
  latitude         Float?
  longitude        Float?
  desiredStartDate DateTime?     @map("desired_start_date")
  childrenCount    Int?          @map("children_count")
  organizationName String?       @map("organization_name")
  status           String        @default("nouveau")
  // nouveau | contacte | en_verification | valide | converti | rejete
  assignedToId     String?       @map("assigned_to")
  assignedTo       AdminAccount? @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  convertedById    String?       @map("converted_by")
  convertedBy      AdminAccount? @relation("ConvertedLeads", fields: [convertedById], references: [id], onDelete: SetNull)
  convertedAt      DateTime?     @map("converted_at")
  students         Student[]
  notes            LeadNote[]
  portalAccount    PortalAccount?
  dispatchLogs     CredentialDispatchLog[]
  messageThreads   MessageThread[]

  @@map("leads")
}

model PortalAccount {
  id                 String                  @id // = auth.users.id (Supabase Auth), jamais généré par Prisma
  email              String                  @unique
  fullName           String                  @map("full_name")
  familyName         String?                 @map("family_name")
  role               String                  // famille | mairie | entreprise | centre_formation_ecole_pro
  mustChangePassword Boolean                 @default(true) @map("must_change_password")
  status             String                  @default("invite") // invite | actif | suspendu
  leadId             String                  @unique @map("lead_id")
  lead               Lead                    @relation(fields: [leadId], references: [id], onDelete: Restrict)
  createdAt          DateTime                @default(now()) @map("created_at")
  dispatchLogs       CredentialDispatchLog[]

  @@map("portal_accounts")
}

model CredentialDispatchLog {
  id              String        @id @default(cuid())
  leadId          String        @map("lead_id")
  lead            Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  portalAccountId String        @map("portal_account_id")
  portalAccount   PortalAccount @relation(fields: [portalAccountId], references: [id], onDelete: Cascade)
  sentById        String?       @map("sent_by")
  sentBy          AdminAccount? @relation("CredentialDispatches", fields: [sentById], references: [id], onDelete: SetNull)
  sentAt          DateTime      @default(now()) @map("sent_at")
  deliveryStatus  String        @map("delivery_status") // envoye | echec
  emailProviderId String?       @map("email_provider_id")

  @@map("credential_dispatch_logs")
}

model Student {
  grades Grade[]
  id             String            @id @default(cuid())
  createdAt      DateTime          @default(now()) @map("created_at")
  name           String
  gender         String?           // homme | femme
  level          String            // primaire | college | lycee
  classe         String?           // 6e | 5e | 4e | 3e | 2nde | 1re | terminale
  sequenceNumber Int               @unique @default(autoincrement()) @map("sequence_number")
  school         String?
  address        String?
  // Ameliore la precision du geocodage (voir GeocodingService.geocode).
  postalCode     String?           @map("postal_code")
  city           String?
  // Geocodees automatiquement (best-effort) a partir de `address` — servent
  // au pin "élève" sur la carte du tableau de bord admin.
  latitude       Float?
  longitude      Float?
  subjects       String[]          @default([])
  objectives     String?
  isActive       Boolean           @default(true) @map("is_active")
  photoPath      String?           @map("photo_path")
  dateNaissance  DateTime?         @map("date_naissance")
  qrToken        String            @unique @map("qr_token")
  passStatus     String            @default("active") @map("pass_status")
  // active | revoked
  parentLeadId   String?           @map("parent_lead_id")
  parentLead     Lead?             @relation(fields: [parentLeadId], references: [id], onDelete: SetNull)
  teachers       StudentTeacher[]
  sessions       Session[]
  progressReports ProgressReport[]
  documents      StudentDocument[]
  teacherHistory StudentTeacherHistory[]
  teacherRequests TeacherRequest[]
  progressEntries ProgressEntry[]
  fundingLinks   FundingLink[]
  attendanceLogs AttendanceLog[]
  recurringSchedules RecurringSchedule[]

  @@map("students")
}

model Teacher {
  grades Grade[]
  id          String                 @id @default(cuid())
  name        String
  gender      String?                // homme | femme
  subjects    String[]
  verified    Boolean                @default(false)
  bio         String?
  // Adresse (ex-"zone") : le prof se déplace pour un cours en présentiel, ce
  // champ sert surtout de repère géographique général, pas un point exact.
  address     String?
  // Ameliore la precision du geocodage (voir GeocodingService.geocode).
  postalCode  String?                @map("postal_code")
  city        String?
  // Jours (Lundi..Dimanche) ou le prof declare pouvoir donner cours : sert a
  // controler (sans bloquer) la planification des seances.
  availabilityDays String[] @default([]) @map("availability_days")
  // Geocodees automatiquement (best-effort) a partir de `address` — servent
  // au pin "enseignant" sur la carte du tableau de bord admin.
  latitude    Float?
  longitude   Float?
  email       String?
  phone       String?
  photoPath   String?                @map("photo_path")
  application TeacherApplication?
  students    StudentTeacher[]
  sessions    Session[]
  history     StudentTeacherHistory[]
  matchings   Matching[]
  account     TeacherAccount?
  payments    TeacherPayment[]
  messageThreads MessageThread[]
  reviews     TeacherReview[]
  supportTickets SupportTicket[]
  attendanceLogs AttendanceLog[]
  progressEntries ProgressEntry[]
  recurringSchedules RecurringSchedule[]
  documents   TeacherDocument[]
  pushSubscriptions PushSubscription[]
  requestInterests TeacherRequestInterest[]

  @@map("teachers")
}

model TeacherPayment {
  id         String    @id @default(cuid())
  teacherId  String    @map("teacher_id")
  teacher    Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  period     String
  hoursGiven Float     @map("hours_given")
  amount     Float
  status     String    @default("verse") // verse | en_attente
  paidAt     DateTime? @map("paid_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("teacher_payments")
}

model MessageThread {
  id            String    @id @default(cuid())
  teacherId     String    @map("teacher_id")
  teacher       Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  leadId        String?   @map("lead_id")
  lead          Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  familyName    String    @map("family_name")
  teacherReadAt DateTime? @map("teacher_read_at")
  familyReadAt  DateTime? @map("family_read_at")
  messages      Message[]
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("message_threads")
}

model Message {
  id            String        @id @default(cuid())
  threadId      String        @map("thread_id")
  thread        MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender        String        // teacher | famille
  body          String
  removedAt     DateTime?     @map("removed_at")
  removedById   String?       @map("removed_by")
  removedBy     AdminAccount? @relation(fields: [removedById], references: [id], onDelete: SetNull)
  removedReason String?       @map("removed_reason")
  createdAt     DateTime      @default(now()) @map("created_at")

  @@map("messages")
}

model TeacherReview {
  id          String   @id @default(cuid())
  teacherId   String   @map("teacher_id")
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  familyName  String   @map("family_name")
  studentName String   @map("student_name")
  rating      Int
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("teacher_reviews")
}

model SupportTicket {
  id        String            @id @default(cuid())
  teacherId String            @map("teacher_id")
  teacher   Teacher           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject   String
  message   String
  status    String            @default("ouvert") // ouvert | traite
  messages  SupportMessage[]
  createdAt DateTime          @default(now()) @map("created_at")

  @@map("support_tickets")
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String        @map("ticket_id")
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    String        // teacher | admin
  body      String
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("support_messages")
}

model Testimonial {
  id        String   @id @default(cuid())
  author    String
  role      String
  quote     String
  rating    Int      @default(5)
  // Ordre d'affichage sur la vitrine (croissant) — independant de la date de creation.
  order     Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("testimonials")
}

// Contenu editable de la vitrine par l'admin (tarif affiche, etc.) — cle/valeur
// pour rester extensible sans nouvelle migration a chaque ajout.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model FaqItem {
  id        String  @id @default(cuid())
  question  String
  answer    String
  order     Int     @default(0)
  published Boolean @default(false)

  @@map("faq_items")
}

model Service {
  id          String  @id @default(cuid())
  title       String
  description String
  icon        String?
  order       Int     @default(0)

  @@map("services")
}

// ─────────────────────────────────────────────
// Super Admin — comptes, rôles (RBAC), audit trail
// ─────────────────────────────────────────────

model AdminAccount {
  // = auth.users.id (Supabase Auth), fourni explicitement à la création,
  // jamais généré côté Prisma.
  id                    String               @id
  email                 String               @unique
  name                  String
  isActive              Boolean              @default(true) @map("is_active")
  createdAt             DateTime             @default(now()) @map("created_at")
  // Droits "<module>:view|edit" (ignores pour un super_admin, qui a tout).
  permissions           String[]             @default([])
  // Zone du delegue : cercle autour de son adresse. Vide = toutes zones.
  zoneAddress           String?              @map("zone_address")
  zoneLatitude          Float?               @map("zone_latitude")
  zoneLongitude         Float?               @map("zone_longitude")
  zoneRadiusKm          Int?                 @map("zone_radius_km")
  roles                 AdminAccountRole[]
  activityLogs          ActivityLog[]
  reviewedApplications  TeacherApplication[] @relation("ReviewedApplications")
  assignedLeads         Lead[]               @relation("AssignedLeads")
  convertedLeads        Lead[]               @relation("ConvertedLeads")
  credentialDispatches  CredentialDispatchLog[] @relation("CredentialDispatches")
  leadNotes             LeadNote[]
  progressReports       ProgressReport[]
  uploadedDocuments     StudentDocument[]
  teacherHistoryEntries StudentTeacherHistory[]
  proposedMatchings     Matching[]              @relation("ProposedMatchings")
  progressEntries       ProgressEntry[]
  teacherCredentialDispatches TeacherCredentialDispatchLog[] @relation("TeacherCredentialDispatches")
  moderatedMessages     Message[]
  contractAmendments    ContractAmendment[]
  rhAccountsInvited     RhAccount[]                     @relation("RhAccountInvitedBy")
  rhCredentialDispatches RhCredentialDispatchLog[]       @relation("RhCredentialDispatches")
  importBatches         ImportBatch[]
  fundingLinkSwitches   FundingLink[]                   @relation("FundingLinkSwitchedBy")
  uploadedTeacherDocuments TeacherDocument[]

  @@map("admin_accounts")
}

model Role {
  id       String             @id @default(cuid())
  name     String             @unique // super_admin | admin
  accounts AdminAccountRole[]

  @@map("roles")
}

model AdminAccountRole {
  adminAccountId String       @map("admin_account_id")
  roleId         String       @map("role_id")
  adminAccount   AdminAccount @relation(fields: [adminAccountId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminAccountId, roleId])
  @@map("admin_account_roles")
}

model ActivityLog {
  id             String       @id @default(cuid())
  adminAccountId String       @map("admin_account_id")
  adminAccount   AdminAccount @relation(fields: [adminAccountId], references: [id], onDelete: Cascade)
  action         String
  targetTable    String?      @map("target_table")
  targetId       String?      @map("target_id")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("activity_logs")
}

// ─────────────────────────────────────────────
// Super Admin — recrutement & validation enseignants
// ─────────────────────────────────────────────

model TeacherApplication {
  id                String        @id @default(cuid())
  candidateName     String        @map("teacher_candidate_name")
  gender            String?       // homme | femme
  candidateEmail    String        @map("teacher_candidate_email")
  phone             String?
  subjects          String[]
  levels            String[]      @default([])
  // primaire | college | lycee
  classes           String[]      @default([])
  // classes precises enseignees, ex: cm2, 6e, 1re — voir CLASSE_LABELS
  zone              String
  postalCode        String        @map("postal_code")
  city              String?
  latitude          Float?
  longitude         Float?
  availability      String?
  status            String        @default("preselection")
  // preselection | entretien_planifie | entretien_realise | valide | refuse | documents_requis
  interviewDate     DateTime?     @map("interview_date")
  interviewNotes    String?       @map("interview_notes")
  bio               String?
  photoPath         String?       @map("photo_path")
  completionToken   String        @unique @map("completion_token")
  reviewedById      String?       @map("reviewed_by")
  reviewedBy        AdminAccount? @relation("ReviewedApplications", fields: [reviewedById], references: [id], onDelete: SetNull)
  decidedAt         DateTime?     @map("decided_at")
  createdTeacherId  String?       @unique @map("created_teacher_id")
  createdTeacher    Teacher?      @relation(fields: [createdTeacherId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now()) @map("created_at")
  documents         TeacherApplicationDocument[]
  teacherAccount    TeacherAccount?

  @@map("teacher_applications")
}

model TeacherApplicationDocument {
  id                   String             @id @default(cuid())
  teacherApplicationId String             @map("teacher_application_id")
  teacherApplication   TeacherApplication @relation(fields: [teacherApplicationId], references: [id], onDelete: Cascade)
  type                 String
  // diplome | casier_judiciaire | autre
  fileName             String             @map("file_name")
  filePath             String             @map("file_path")
  createdAt            DateTime           @default(now()) @map("created_at")

  @@map("teacher_application_documents")
}

model TeacherAccount {
  id                   String                          @id // = auth.users.id (Supabase Auth), jamais généré par Prisma
  email                String                          @unique
  fullName             String                          @map("full_name")
  mustChangePassword   Boolean                         @default(true) @map("must_change_password")
  status               String                          @default("invite") // invite | actif | suspendu
  teacherApplicationId String                          @unique @map("teacher_application_id")
  teacherApplication   TeacherApplication              @relation(fields: [teacherApplicationId], references: [id], onDelete: Restrict)
  teacherId            String?                         @unique @map("teacher_id")
  teacher              Teacher?                        @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  createdAt            DateTime                        @default(now()) @map("created_at")
  dispatchLogs         TeacherCredentialDispatchLog[]

  @@map("teacher_accounts")
}

model TeacherCredentialDispatchLog {
  id                   String         @id @default(cuid())
  teacherApplicationId String         @map("teacher_application_id")
  teacherAccountId     String         @map("teacher_account_id")
  teacherAccount       TeacherAccount @relation(fields: [teacherAccountId], references: [id], onDelete: Cascade)
  sentById             String?        @map("sent_by")
  sentBy               AdminAccount?  @relation("TeacherCredentialDispatches", fields: [sentById], references: [id], onDelete: SetNull)
  sentAt               DateTime       @default(now()) @map("sent_at")
  deliveryStatus       String         @map("delivery_status") // envoye | echec
  emailProviderId      String?        @map("email_provider_id")

  @@map("teacher_credential_dispatch_logs")
}

// ─────────────────────────────────────────────
// Super Admin — Leads / CRM
// ─────────────────────────────────────────────

model LeadNote {
  id             String       @id @default(cuid())
  leadId         String       @map("lead_id")
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  adminAccountId String       @map("admin_account_id")
  adminAccount   AdminAccount @relation(fields: [adminAccountId], references: [id], onDelete: Cascade)
  note           String
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("lead_notes")
}

// ─────────────────────────────────────────────
// Super Admin — Gestion des élèves
// ─────────────────────────────────────────────

model StudentTeacher {
  id         String   @id @default(cuid())
  studentId  String   @map("student_id")
  teacherId  String   @map("teacher_id")
  subject    String?
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @map("assigned_at")
  // Fin de la periode d'accompagnement (assignedAt + duree demandee), prolongee
  // a chaque renouvellement confirme.
  endsAt     DateTime? @map("ends_at")
  // Tarif horaire verse au prof pour CET eleve (et cette matiere), fixe par
  // l'admin : un meme prof peut avoir des tarifs differents selon l'eleve.
  hourlyRate Float?    @map("hourly_rate")
  renewals   PeriodRenewal[]

  @@unique([studentId, teacherId, subject])
  @@map("student_teachers")
}

model Session {
  id        String    @id @default(cuid())
  studentId String    @map("student_id")
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String?   @map("teacher_id")
  teacher   Teacher?  @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  date      DateTime
  // Tarif horaire fige a la cloture de la seance : une modification ulterieure
  // du tarif ne reprix pas les seances deja donnees.
  hourlyRate Float? @map("hourly_rate")
  durationMinutes Int @default(60) @map("duration_minutes")
  subject   String?
  status    String    @default("planifiee")
  // planifiee | confirmee | realisee | annulee | reportee
  attended  Boolean?
  // Compte-rendu structure (= le bilan de la seance). `notes` en garde un
  // resume texte compose a partir de ces champs (et les anciens comptes-rendus
  // libres y restent tels quels).
  chapter       String?
  topics        String?
  understanding Int?
  participation Int?
  difficulties  String?
  homework      String?
  notes     String?
  cancellationReason String? @map("cancellation_reason")
  createdAt DateTime  @default(now()) @map("created_at")
  attendanceLogs AttendanceLog[]
  scheduleId String?  @map("schedule_id")
  schedule   RecurringSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  // Evite de renvoyer plusieurs fois le rappel push "pense a scanner" au
  // debut / a la fin de la seance (cron qui tourne toutes les minutes).
  checkinReminderSentAt  DateTime? @map("checkin_reminder_sent_at")
  checkoutReminderSentAt DateTime? @map("checkout_reminder_sent_at")
  // Evite de renvoyer plusieurs fois l'email "compte-rendu manquant" pour la
  // meme seance (cron horaire, cf. TeacherService.remindMissingReports).
  reportReminderSentAt   DateTime? @map("report_reminder_sent_at")
  // Rappel par email (prof + famille) ~5h avant le debut de la seance —
  // distinct des rappels push de pointage (10 min avant), cf.
  // SessionReminderService.sendUpcomingSessionEmails.
  emailReminderSentAt    DateTime? @map("email_reminder_sent_at")

  @@map("sessions")
}

// Abonnement Web Push d'un enseignant (un par appareil/navigateur).
model PushSubscription {
  id        String   @id @default(cuid())
  teacherId String   @map("teacher_id")
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([teacherId])
  @@map("push_subscriptions")
}

// Planning recurrent d'un eleve avec un enseignant (ex: 2x/semaine, lundi
// 14h et vendredi 18h). Genere automatiquement des Session reelles sur une
// fenetre glissante (cf RecurringScheduleService) : le pointage QR continue
// de s'appuyer uniquement sur des Session concretes, jamais sur ce modele.
model RecurringSchedule {
  id              String   @id @default(cuid())
  studentId       String   @map("student_id")
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId       String   @map("teacher_id")
  teacher         Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  frequency       Int
  // nombre de seances par semaine, doit correspondre au nombre de creneaux
  subject         String
  // Un prof peut avoir plusieurs matieres pour le meme eleve (ex: Maths ET
  // Physique-Chimie) : chaque matiere a son propre planning independant.
  durationMinutes Int      @default(60) @map("duration_minutes")
  // Creneaux : [{ "dayOfWeek": 1, "time": "14:00" }, ...] — dayOfWeek en ISO
  // (1 = lundi ... 7 = dimanche)
  slots           Json
  active          Boolean  @default(true)
  // Date de la 1ere seance : la generation part de la, pas d'aujourd'hui.
  startsOn        DateTime? @map("starts_on")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  sessions        Session[]

  @@unique([studentId, teacherId, subject])
  @@map("recurring_schedules")
}

model ProgressReport {
  id             String       @id @default(cuid())
  studentId      String       @map("student_id")
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  adminAccountId String       @map("admin_account_id")
  adminAccount   AdminAccount @relation(fields: [adminAccountId], references: [id], onDelete: Cascade)
  period         String?
  content        String
  shareable      Boolean      @default(false)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("progress_reports")
}

model ProgressEntry {
  id             String       @id @default(cuid())
  studentId      String       @map("student_id")
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject        String
  status         String
  // acquis | en_progres | a_surveiller | pas_commence
  adminAccountId String?      @map("admin_account_id")
  adminAccount   AdminAccount? @relation(fields: [adminAccountId], references: [id], onDelete: Cascade)
  teacherId      String?      @map("teacher_id")
  teacher        Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([studentId, subject])
  @@map("progress_entries")
}

model StudentDocument {
  id           String       @id @default(cuid())
  studentId    String       @map("student_id")
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  uploadedById String       @map("uploaded_by")
  uploadedBy   AdminAccount @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  type         String
  // bulletin | compte_rendu | autre
  fileName     String       @map("file_name")
  filePath     String       @map("file_path")
  createdAt    DateTime     @default(now()) @map("created_at")

  @@map("student_documents")
}

model TeacherDocument {
  id           String       @id @default(cuid())
  teacherId    String       @map("teacher_id")
  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  uploadedById String       @map("uploaded_by")
  uploadedBy   AdminAccount @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  type         String
  // diplome | casier_judiciaire | autre
  fileName     String       @map("file_name")
  filePath     String       @map("file_path")
  createdAt    DateTime     @default(now()) @map("created_at")

  @@map("teacher_documents")
}

model StudentTeacherHistory {
  id             String       @id @default(cuid())
  studentId      String       @map("student_id")
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId      String       @map("teacher_id")
  teacher        Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  action         String
  // assigned | unassigned
  adminAccountId String       @map("admin_account_id")
  adminAccount   AdminAccount @relation(fields: [adminAccountId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("student_teacher_history")
}

// ─────────────────────────────────────────────
// Portail Famille — Demande de professeur & matching
// ─────────────────────────────────────────────

model TeacherRequest {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now()) @map("created_at")
  studentId    String     @map("student_id")
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject      String
  frequency    String
  format       String
  // presentiel | distanciel | hybride
  durationMinutes Int? @map("duration_minutes")
  // Duree de seance souhaitee par la famille : sert de defaut au prof quand
  // il construira le planning, pour eviter qu'il ait a la redefinir.
  availability String?
  // Date de debut de cours souhaitee par la famille (facultative).
  desiredStartDate DateTime? @map("desired_start_date")
  // Duree d'accompagnement souhaitee (objectif, renouvelable) : 1, 2, 3 ou 6 mois.
  periodMonths Int? @map("period_months")
  status       String     @default("en_attente")
  // en_attente | proposition_envoyee | acceptee | annulee
  matchings    Matching[]
  interests    TeacherRequestInterest[]

  @@index([studentId])
  @@map("teacher_requests")
}

// Un prof se déclare "intéressé" par une demande qui correspond à ses
// matières, sans que ce soit encore une proposition admin (Matching) : ça
// aide l'admin à repérer rapidement qui proposer, sans lui imposer un choix.
model TeacherRequestInterest {
  id               String         @id @default(cuid())
  createdAt        DateTime       @default(now()) @map("created_at")
  teacherRequestId String         @map("teacher_request_id")
  teacherRequest   TeacherRequest @relation(fields: [teacherRequestId], references: [id], onDelete: Cascade)
  teacherId        String         @map("teacher_id")
  teacher          Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  // true = "Intéressé", false = "Pas intéressé" : l'admin voit les deux.
  interested       Boolean        @default(true)

  @@unique([teacherRequestId, teacherId])
  @@index([teacherId])
  @@map("teacher_request_interests")
}

model Matching {
  id               String         @id @default(cuid())
  createdAt        DateTime       @default(now()) @map("created_at")
  teacherRequestId String         @map("teacher_request_id")
  teacherRequest   TeacherRequest @relation(fields: [teacherRequestId], references: [id], onDelete: Cascade)
  teacherId        String         @map("teacher_id")
  teacher          Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  proposedById     String         @map("proposed_by")
  proposedBy       AdminAccount   @relation("ProposedMatchings", fields: [proposedById], references: [id], onDelete: Cascade)
  status           String         @default("proposee")
  // proposee | acceptee | refusee
  refusalReason    String?        @map("refusal_reason")
  // Tarif horaire propose au prof, reporte sur l'accompagnement a l'acceptation.
  hourlyRate       Float?         @map("hourly_rate")
  respondedAt      DateTime?      @map("responded_at")

  @@index([teacherRequestId])
  @@index([teacherId])
  @@map("matchings")
}

// ─────────────────────────────────────────────
// Module Entreprise — Pass Éducatif (Phase 1 : fondations)
// Entreprises, catalogue de Formules, contrats + avenants, comptes RH.
// Import des bénéficiaires, funding_links, Pass QR/pointage : phases suivantes.
// ─────────────────────────────────────────────

model Enterprise {
  id                 String               @id @default(cuid())
  raisonSociale      String               @map("raison_sociale")
  siret              String?              @unique
  secteurActivite    String?              @map("secteur_activite")
  emailDomain        String?              @map("email_domain")
  adresseFacturation String?              @map("adresse_facturation")
  createdAt          DateTime             @default(now()) @map("created_at")
  contracts          EnterpriseContract[]
  rhAccounts         RhAccount[]
  employees          Employee[]
  importBatches      ImportBatch[]

  @@map("enterprises")
}

model Formula {
  id                             String               @id @default(cuid())
  nom                            String
  budgetCreditDefault            Float                @map("budget_credit_default")
  uniteCredit                    String               @map("unite_credit")
  // euros | heures
  plafondBeneficiairesParEmploye Int?                 @map("plafond_beneficiaires_par_employe")
  matieresEligibles              String[]             @default([]) @map("matieres_eligibles")
  createdAt                      DateTime             @default(now()) @map("created_at")
  contracts                      EnterpriseContract[]

  @@map("formulas")
}

model EnterpriseContract {
  id                   String              @id @default(cuid())
  enterpriseId         String              @map("enterprise_id")
  enterprise           Enterprise          @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  formulaId            String              @map("formula_id")
  formula              Formula             @relation(fields: [formulaId], references: [id], onDelete: Restrict)
  budgetCreditOverride Float?              @map("budget_credit_override")
  dateDebut            DateTime            @map("date_debut")
  dateExpiration       DateTime            @map("date_expiration")
  statut               String              @default("brouillon")
  // brouillon | actif | expire | renouvele | resilie
  expiryAlertSentAt    DateTime?           @map("expiry_alert_sent_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  amendments           ContractAmendment[]
  employees            Employee[]
  importBatches        ImportBatch[]

  @@index([enterpriseId])
  @@map("enterprise_contracts")
}

model ContractAmendment {
  id             String             @id @default(cuid())
  contractId     String             @map("contract_id")
  contract       EnterpriseContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  type           String
  // montant_revise | formule_changee | duree_prolongee
  ancienneValeur String?            @map("ancienne_valeur")
  nouvelleValeur String?            @map("nouvelle_valeur")
  dateEffet      DateTime           @default(now()) @map("date_effet")
  createdById    String             @map("created_by")
  createdBy      AdminAccount       @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([contractId])
  @@map("contract_amendments")
}

model RhAccount {
  // = auth.users.id (Supabase Auth), jamais généré par Prisma
  id                 String                    @id
  email              String                    @unique
  fullName           String                    @map("full_name")
  enterpriseId       String                    @map("enterprise_id")
  enterprise         Enterprise                @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  role               String                    @default("owner")
  // owner | assistant | lecture_seule
  mustChangePassword Boolean                   @default(true) @map("must_change_password")
  status             String                    @default("invite") // invite | actif | suspendu
  invitedByAdminId   String?                   @map("invited_by_admin")
  invitedByAdmin     AdminAccount?             @relation("RhAccountInvitedBy", fields: [invitedByAdminId], references: [id], onDelete: SetNull)
  createdAt          DateTime                  @default(now()) @map("created_at")
  dispatchLogs       RhCredentialDispatchLog[]

  @@index([enterpriseId])
  @@map("rh_accounts")
}

model RhCredentialDispatchLog {
  id              String        @id @default(cuid())
  rhAccountId     String        @map("rh_account_id")
  rhAccount       RhAccount     @relation(fields: [rhAccountId], references: [id], onDelete: Cascade)
  sentById        String?       @map("sent_by")
  sentBy          AdminAccount? @relation("RhCredentialDispatches", fields: [sentById], references: [id], onDelete: SetNull)
  sentAt          DateTime      @default(now()) @map("sent_at")
  deliveryStatus  String        @map("delivery_status") // envoye | echec
  emailProviderId String?       @map("email_provider_id")

  @@map("rh_credential_dispatch_logs")
}

// ─────────────────────────────────────────────
// Module Entreprise — Import des bénéficiaires (Phase 2)
// Un Employee est identifié par (enterpriseId, emailPro) et réutilisé d'un
// import à l'autre pour rattacher plusieurs enfants. Aucun compte Supabase
// Auth n'est créé pour l'employé ici : le Portail Employé n'existe pas
// encore (voir Phase 1, section "Reporté"). Pas de backfill de funding_links
// pour les élèves déjà financés par une famille (fonctionnement inchangé via
// Student.parentLeadId) — funding_links ne couvre ici que le financement
// entreprise.
// ─────────────────────────────────────────────

model Employee {
  id           String              @id @default(cuid())
  enterpriseId String              @map("enterprise_id")
  enterprise   Enterprise          @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  contractId   String              @map("contract_id")
  contract     EnterpriseContract  @relation(fields: [contractId], references: [id], onDelete: Restrict)
  nom          String
  prenom       String
  emailPro     String              @map("email_pro")
  status       String              @default("pending_invitation")
  // pending_invitation | active | inactive
  createdAt    DateTime            @default(now()) @map("created_at")
  fundingLinks FundingLink[]

  @@unique([enterpriseId, emailPro])
  @@index([contractId])
  @@map("employees")
}

model FundingLink {
  id                String        @id @default(cuid())
  studentId         String        @map("student_id")
  student           Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fundingSource     String        @map("funding_source")
  // family | enterprise | mairie
  employeeId        String?       @map("employee_id")
  employee          Employee?     @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  status            String        @default("active")
  // active | closed
  dateDebut         DateTime      @default(now()) @map("date_debut")
  dateFin           DateTime?     @map("date_fin")
  switchedByAdminId String?       @map("switched_by_admin_id")
  switchedByAdmin   AdminAccount? @relation("FundingLinkSwitchedBy", fields: [switchedByAdminId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now()) @map("created_at")

  @@index([studentId])
  @@index([employeeId])
  @@map("funding_links")
}

model ImportBatch {
  id           String             @id @default(cuid())
  enterpriseId String             @map("enterprise_id")
  enterprise   Enterprise         @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  contractId   String             @map("contract_id")
  contract     EnterpriseContract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  fileName     String             @map("file_name")
  createdCount Int                @map("created_count")
  skippedCount Int                @map("skipped_count")
  createdById  String             @map("created_by")
  createdBy    AdminAccount       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime           @default(now()) @map("created_at")

  @@index([enterpriseId])
  @@map("import_batches")
}

// ─────────────────────────────────────────────
// Module Entreprise — Pass QR / pointage (Phase 3)
// Une ligne AttendanceLog couvre un cycle checkin→checkout (pas un scan) :
// le 1er scan valide crée la ligne, le 2e la complète. Les scans bloqués
// (pass révoqué, financement expiré) créent chacun leur propre ligne pour
// l'audit, sauf si le token ne correspond à aucun élève (rien à journaliser).
// ─────────────────────────────────────────────

model AttendanceLog {
  id                 String    @id @default(cuid())
  sessionId          String?   @map("session_id")
  session            Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  studentId          String    @map("student_id")
  student            Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId          String    @map("teacher_id")
  teacher            Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  checkinAt          DateTime? @map("checkin_at")
  checkoutAt         DateTime? @map("checkout_at")
  verificationStatus String    @map("verification_status")
  // valid | funding_expired | pass_revoked | no_session_found
  method             String
  // qr_scan | manuel
  manualReason       String?   @map("manual_reason")
  // qr_oublie | probleme_technique | autre
  earlyEndReason     String?   @map("early_end_reason")
  // Raison donnee par le prof quand il confirme une fin de seance anticipee
  createdAt          DateTime  @default(now()) @map("created_at")

  @@index([studentId])
  @@index([sessionId])
  @@index([teacherId])
  @@map("attendance_logs")
}

// Demande de renouvellement d'une periode d'accompagnement : la famille
// demande, le prof accepte ou decline, l'admin confirme. Un refus du prof
// ouvre automatiquement une nouvelle demande de professeur (newRequestId).
model PeriodRenewal {
  id                 String         @id @default(cuid())
  createdAt          DateTime       @default(now()) @map("created_at")
  studentTeacherId   String         @map("student_teacher_id")
  studentTeacher     StudentTeacher @relation(fields: [studentTeacherId], references: [id], onDelete: Cascade)
  periodMonths       Int            @map("period_months")
  status             String         @default("en_attente_prof")
  // en_attente_prof | acceptee_prof | refusee_prof | confirmee | refusee_admin
  teacherComment     String?        @map("teacher_comment")
  teacherRespondedAt DateTime?      @map("teacher_responded_at")
  decidedAt          DateTime?      @map("decided_at")
  decidedById        String?        @map("decided_by")
  adminReason        String?        @map("admin_reason")
  newRequestId       String?        @map("new_request_id")

  @@index([studentTeacherId])
  @@map("period_renewals")
}

// Note d'evaluation saisie par le prof (relevee sur Pronote). "depart" = notes
// d'avant l'accompagnement (point de comparaison obligatoire), "suivi" = notes
// obtenues pendant. Toutes ramenees sur 20 pour la progression.
model Grade {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now()) @map("created_at")
  studentId   String   @map("student_id")
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId   String?  @map("teacher_id")
  teacher     Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  subject     String
  kind        String   // depart | suivi
  value       Float
  scale       Float    @default(20)
  evaluatedAt DateTime @map("evaluated_at")
  comment     String?

  @@index([studentId, subject])
  @@map("grades")
}

// ─────────────────────────────────────────────
// Catalogue des matieres (gere par le Super Admin)
// ─────────────────────────────────────────────

model Subject {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  // Nom stocke tel quel dans Teacher.subjects, TeacherApplication.subjects…
  // (jamais renomme : masquer ou supprimer).
  name      String   @unique
  category  String   // scolaire | professionnel
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("subjects")
}
